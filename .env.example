# ==========================================
# StudentHub AI Outreach Agent Configuration
# ==========================================

# Environment Mode: 'live' or 'test' (test mode provides reproducible, deterministic research for evaluation without burning API credits)
TEST_MODE=true

# Application Secrets & Host
APP_SECRET_KEY=studenthub_outreach_secret_key_change_in_production
PORT=8000
HOST=127.0.0.1

# Owner Configuration (Recipient for the automated Company Research Report)
OWNER_EMAIL=suchithreddy@studenthub.co
FOUNDER_NAME=Suchithreddy G
FOUNDER_ROLE=CEO
FOUNDER_COMPANY=StudentHub

# Hugging Face Inference API Configuration
# Get token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Configurable Open-Weight Model (supported via HF Inference Providers)
# e.g., meta-llama/Meta-Llama-3-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.3, Qwen/Qwen2.5-7B-Instruct
HF_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# Web Search API Configuration
# Options: 'tavily', 'serpapi', 'mock'
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# Google OAuth 2.0 Credentials (Gmail API)
# Setup in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Database
DATABASE_URL=sqlite:///./studenthub_outreach.db
